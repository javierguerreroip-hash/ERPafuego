# Cadena de conexión a la base de datos (debe coincidir con docker-compose.yml / .env raíz).
# En local, DATABASE_URL y DIRECT_URL son iguales (no hay pooler). En
# producción con Supabase son DISTINTAS — ver README.md, sección
# "Despliegue": DATABASE_URL = conexión "pooled" (puerto 6543), DIRECT_URL
# = conexión directa (puerto 5432, la usan las migraciones).
DATABASE_URL="postgresql://afuego:afuego_dev_password@localhost:5432/afuego_erp?schema=public"
DIRECT_URL="postgresql://afuego:afuego_dev_password@localhost:5432/afuego_erp?schema=public"

# Puerto donde corre la API
PORT=4000

# Origen permitido para CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los JWT (cambiar en producción)
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h
