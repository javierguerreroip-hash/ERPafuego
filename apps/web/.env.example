# URL base de la API backend.
# En local: el backend Express corre aparte (puerto 4000).
# En Netlify: usar "/api" (mismo origen — netlify.toml redirige /api/* a
# la función) — se configura como variable de entorno de BUILD en el
# panel de Netlify, no aquí (Vite la incrusta al compilar). Ver
# README.md, sección "Despliegue".
VITE_API_URL=http://localhost:4000/api
